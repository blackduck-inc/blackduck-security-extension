{
  "name": "blackduck-security-scan",
  "version": "2.9.0",
  "main": "lib/main.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "package": "ncc build --source-map",
    "lint": "eslint src/**/*.ts",
    "test": "nyc --reporter=html --reporter=text mocha --require ts-node/register test/unit/**/*.spec.ts test/unit/*.spec.ts",
    "all": "npm run format && npm run lint && npm run build && npm run package && npm run test",
    "format": "prettier 'src/**/*.ts' --write",
    "integraionTestBuild": "tsc --project tsconfig-int-test.json",
    "integrationTest": "npm run build && npm run integraionTestBuild && mocha test/integration/_suite.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "azure-pipelines-task-lib": "5.2.10",
    "azure-pipelines-tool-lib": "2.0.12",
    "dom-parser": "0.1.6",
    "flatted": "3.4.4",
    "http-proxy-agent": "9.1.0",
    "https-proxy-agent": "9.1.0",
    "semver": "7.8.5",
    "vss-web-extension-sdk": "5.141.0"
  },
  "devDependencies": {
    "@types/chai": "4.3.4",
    "@types/dom-parser": "0.1.4",
    "@types/mocha": "10.0.10",
    "@types/node": "24.5.2",
    "@types/q": "1.5.8",
    "@types/semver": "7.7.1",
    "@types/sinon": "22.0.0",
    "@types/unzipper": "0.10.10",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vercel/ncc": "0.38.4",
    "chai": "4.5.0",
    "eslint": "10.9.1",
    "eslint-plugin-jest": "29.15.2",
    "mocha": "11.7.6",
    "nock": "13.5.6",
    "nyc": "18.0.0",
    "path": "0.12.7",
    "prettier": "3.9.9",
    "sinon": "22.1.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.2",
    "unzipper": "0.12.5",
    "uuid": "10.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6",
    "underscore": "1.13.8",
    "jsdiff": "8.0.4",
